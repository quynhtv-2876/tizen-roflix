# ==========================
# Sensitive / Secret Files
# ==========================

# Server environment variables (contains API_KEY)
roflix-server/.env
roflix-server/data/

# Tizen signing certificates (NEVER commit these)
*.p12
*.pfx
*.pwd
*.crt
*.key
*.pem
*.cert
*.keystore
.keystore
author.pwd
distributor.pwd
tizen.certificate

# ==========================
# Tizen Studio IDE Artifacts
# ==========================

# IDE workspace metadata (generated by Tizen Studio)
.metadata/

# Tizen project build artifacts
roflix/.buildResult/
roflix/roflix.wgt
roflix/*.wgt

# ==========================
# Node.js
# ==========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-store

# ==========================
# Logs & Debug
# ==========================

*.log
logs/
.log

# ==========================
# OS Files
# ==========================

.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================
# Editor / IDE
# ==========================

.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ==========================
# Large binary installers
# ==========================

# Ignore Tizen Studio web-cli, web-ide and other binaries
*.bin
*.exe
*.dmg
*.deb
*.rpm

# ==========================
# Documentation & Internal Notes
# ==========================

# Ignore internally generated docs and artifacts
stocks/
BUGFIX_SUMMARY.md

# ==========================
# Docker
# ==========================

# Do NOT ignore Dockerfile — it should be committed
# But ignore any local override files
docker-compose.override.yml
